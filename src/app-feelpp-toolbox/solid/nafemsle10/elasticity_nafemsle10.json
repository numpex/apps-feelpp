{
    "executable":"feelpp_toolbox_solid",
    "output_directory": "{{machine.output_app_dir}}/toolboxes/solid/NAFEMSLE10",
    "use_case_name": "NAFEMS_LE10",
    "timeout":"0-00:20:00",
    "resources":{
        "tasks":"{{parameters.tasks.value}}",
        "exclusive_access":true
    },
    "input_file_dependencies":{
        "case_cfg":"feelpp_toolboxes/{{use_case_name}}/le10.cfg",
        "mesh_json":"feelpp_toolboxes/{{use_case_name}}/{{parameters.mesh.value}}/le10_p{{parameters.tasks.value}}.json",
        "mesh_hdf5":"feelpp_toolboxes/{{use_case_name}}/{{parameters.mesh.value}}/le10_p{{parameters.tasks.value}}.h5"
    },

    "platforms": {
        "apptainer":{
            "image": {
                "filepath":"{{machine.containers.apptainer.image_base_dir}}/feelpp-noble.sif"
            },
            "input_dir":"/input_data",
            "options": [
                "--home {{machine.output_app_dir}}",
                "--bind {{machine.input_dataset_base_dir}}/:{{platforms.apptainer.input_dir}}",
                "--env OMP_NUM_THREADS=1"
            ]
        },
        "builtin":{
            "input_dir":"{{machine.input_dataset_base_dir}}"
        }
    },
    "options": [
        "--config-files {{platforms.{{machine.platform}}.input_dir}}/{{input_file_dependencies.case_cfg}}",
        "--directory {{output_directory}}/{{instance}}",
        "--repository.case {{use_case_name}}",
        "--solid.scalability-save=1",
        "--repository.append.np 0",
        "--case.discretization {{parameters.discretization.value}}",
        "--solid.json.patch='{\"op\": \"replace\",\"path\": \"/Meshes/solid/Import/filename\",\"value\": \"{{platforms.{{machine.platform}}.input_dir}}/{{input_file_dependencies.mesh_json}}\" }'"
    ],
    "additional_files":{
        "parameterized_descriptions_filepath":"{{output_directory}}/{{instance}}/{{use_case_name}}/solid.information.adoc",
        "custom_logs":[
            "{{output_directory}}/{{instance}}/{{use_case_name}}/logs/feelpp_toolbox_solid.INFO",
            "{{output_directory}}/{{instance}}/{{use_case_name}}/logs/feelpp_toolbox_solid.WARNING"
        ]
    },
    "scalability": {
        "directory": "{{output_directory}}/{{instance}}/{{use_case_name}}",
        "clean_directory":false,
        "stages": [
            {
                "name": "Constructor",
                "filepath": "solid.scalibility.SolidMechanicsConstructor.data",
                "format": "tsv"
            },
            {
                "name": "PostProcessing",
                "filepath": "solid.scalibility.SolidMechanicsPostProcessing.data",
                "format": "tsv"
            },
            {
                "name": "Solve",
                "filepath": "solid.scalibility.SolidMechanicsSolve.data",
                "format": "tsv"
            },
            {
                "name": "Outputs",
                "filepath": "solid.measures/values.csv",
                "format": "csv",
                "units": { "*": "Pa" }
            }
        ],
        "custom_variables": [
            {
                "name":"Total",
                "columns":["Constructor_init","Solve_solve","PostProcessing_exportResults" ],
                "op":"sum",
                "unit":"s"
            }
        ]
    },
    "parameters": [
        {
            "name":"tasks",
            "sequence": [32,64,128,256,384,512]
        },
        {
            "name":"mesh",
            "sequence":["M1","M2","M3"]
        },
        {
            "name":"discretization",
            "sequence":["P1","P2"]
        }
    ]
}