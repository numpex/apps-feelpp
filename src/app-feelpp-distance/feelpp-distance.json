{
    "executable": "/data/home/cladellash/apps-feelpp/build/default/src/app-feelpp-distance/feelpp_app_distance",
    "use_case_name": "cube",
    "output_directory": "{{machine.output_app_dir}}/app_feelpp_distance/cube",
    "timeout": "0-00:10:00",
    "resources": {
        "tasks": "{{parameters.tasks.value}}",
        "exclusive_access": true
    },
    "input_file_dependencies": {
        "mesh_json":"app-feelpp-distance/{{use_case_name}}/{{parameters.mesh.name.value}}/dist_p{{parameters.tasks.value}}.json",
        "mesh_hdf5":"app-feelpp-distance/{{use_case_name}}/{{parameters.mesh.name.value}}/dist_p{{parameters.tasks.value}}.h5"
    },
    "platforms": {
        "apptainer":{
            "image": {
                "filepath":"{{machine.containers.apptainer.image_base_dir}}/apps-feelpp.sif"
            },
            "input_dir":"/input_data",
            "options": [
                "--home {{machine.output_app_dir}}",
                "--bind {{machine.input_dataset_base_dir}}:{{platforms.apptainer.input_dir}}",
                "--env OMP_NUM_THREADS=1"
            ]
        },
        "builtin": {
            "input_dir": "{{machine.input_dataset_base_dir}}"
        }
    },
    "options": [
        "--directory {{output_directory}}/{{instance}}/{{use_case_name}}",
        "--repository.append.np 0",
        "--gmsh.filename {{platforms.{{machine.platform}}.input_dir}}/{{input_file_dependencies.mesh_json}}",
        "--M {{parameters.M.value}}"
    ],
    "additional_files": {
        "custom_logs": [
            "{{output_directory}}/{{instance}}/{{use_case_name}}/logs/feelpp_app_distance.INFO",
            "{{output_directory}}/{{instance}}/{{use_case_name}}/logs/feelpp_app_distance.WARNING"
        ]
    },
    "scalability": {
        "directory": "{{output_directory}}/{{instance}}/{{use_case_name}}",
        "clean_directory": false,
        "stages": [
            {
                "name": "times",
                "filepath": "measures.json",
                "format": "json",
                "variables_path": "time.*",
                "units": { "*": "s" }
            },
            {
                "name": "errors",
                "filepath": "measures.json",
                "format": "json",
                "variables_path": "error.*",
                "units": { "*": "s" }
            },
            {
                "name": "meshStats",
                "filepath": "mesh_stats.csv",
                "format": "csv"
            }
        ]
    },
    "sanity": {
        "success": [],
        "error": []
    },
    "parameters": [
        {
            "name": "tasks",
            "sequence": [1,2,4,8,16,32,64,128,256]
        },
        {
            "name": "mesh",
            "sequence": [
                {"name":"M1", "h":"0.12" },
                {"name":"M2", "h":"0.06" },
                {"name":"M3", "h":"0.03" },
                {"name":"M4", "h":"0.015" }
            ]
        },
        {
            "name": "M",
            "sequence": [ 1000, 1500, 2000, 2500]
        }
    ]
}
