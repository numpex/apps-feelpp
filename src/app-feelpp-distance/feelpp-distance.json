{
    "executable": "feelpp_app_distance",
    "use_case_name": "cube",
    "output_directory": "{{machine.output_app_dir}}/app_feelpp_distance/cube",
    "timeout": "0-00:10:00",
    "resources": {
        "tasks": "{{parameters.tasks.value}}",
        "exclusive_access": true
    },
    "input_file_dependencies": {
        "config": "$PWD/src/app-feelpp-distance/dist2.cfg",
        "geometry": "$PWD/src/app-feelpp-distance/dist.geo"
    },
    "platforms": {
        "apptainer":{
            "image": {
                "filepath":"{{machine.containers.apptainer.image_base_dir}}/apps-feelpp.sif"
            },
            "input_dir":"/input_data",
            "options": [
                "--home {{machine.output_app_dir}}",
                "--bind $PWD/src/app-feelpp-distance/:{{platforms.apptainer.input_dir}}",
                "--env OMP_NUM_THREADS=1"
            ]
        },
        "builtin": {
            "input_dir": "$PWD/src/app-feelpp-distance"
        }
    },
    "options": [
        "--directory {{output_directory}}/{{instance}}/{{use_case_name}}",
        "--h {{parameters.h.value}}",
        "--M {{parameters.M.value}}",
        "--repository.append.np 0",
        "--config-file {{input_file_dependencies.config}}"
    ],
    "additional_files": {
        "custom_logs": [
            "{{output_directory}}/{{instance}}/{{use_case_name}}/logs/feelpp_app_distance.INFO",
            "{{output_directory}}/{{instance}}/{{use_case_name}}/logs/feelpp_app_distance.WARNING"
        ]
    },
    "scalability": {
        "directory": "{{output_directory}}/{{instance}}/{{use_case_name}}",
        "clean_directory": false,
        "stages": [
            {
                "name": "times",
                "filepath": "measures.json",
                "format": "json",
                "variables_path": "time.*",
                "units": { "*": "s" }
            },
            {
                "name": "errors",
                "filepath": "measures.json",
                "format": "json",
                "variables_path": "error.*",
                "units": { "*": "s" }
            }
        ]
    },
    "sanity": {
        "success": [],
        "error": []
    },
    "parameters": [
        {
            "name": "tasks",
            // "sequence": [ 1,2,4,8,16,32,64,128,256]
            "sequence": [ 1]
        },
        {
            "name": "h",
            // "sequence": [ 0.12, 0.06, 0.03, 0.015 ]
            "sequence": [ 0.12]
        },
        {
            "name": "M",
            // "sequence": [ 1000, 1500, 2000, 2500]
            "sequence": [ 1000]
        }
    ]
}